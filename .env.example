# ============================================================
# BlockHub server - environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:pass@cluster/blockhub
REDIS_URL=

# Auth
JWT_SECRET=change-me
SESSION_SECRET=change-me-too
TUTOR_SECRET_KEY=
TUTOR_ACCESS_SECRET_KEY=
FIXED_USER_PASSWORD=

# URLs
FRONTEND_URL=http://localhost:5173
USER_FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:8080
API_URL=http://localhost:8080
# Extra CORS origins, comma separated (optional)
EXTRA_CORS_ORIGINS=

# ------------------------------------------------------------
# BlockHub Live (video classes) - from https://cloud.livekit.io
#   Project -> Settings -> Keys
# ------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional
LIVE_CLASS_MAX_PARTICIPANTS=150
LIVE_CLASS_TOKEN_TTL=3h

# Cohort
COHORT_1_START_DATE=2026-10-27T18:00:00.000Z
COHORT_1_END_DATE=2026-12-18T18:00:00.000Z
# Timezone tutors enter class times in (Lagos = +01:00)
COHORT_UTC_OFFSET=+01:00
# BlockHub community link (shown on dashboards and in emails)
COHORT_COMMUNITY_LINK=
# Fallback curriculum if the track tutor hasn't set one
COHORT_CURRICULUM_LINK=

# ------------------------------------------------------------
# Email (see services/email/config.js for all options)
# ------------------------------------------------------------
# Sender shown to users
EMAIL_FROM="BlockHub <hello@blockhubglobal.xyz>"
EMAIL_REPLY_TO=

# Provider: any SMTP. Leave SMTP_HOST empty to keep using Gmail.
# Example for Resend (https://resend.com):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_xxx
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# If SMTP_HOST is empty, Gmail is used with these:
MAIL_USER=
MAIL_PASS=

# TEST MODE: true = every email goes ONLY to the addresses below
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENTS=you@example.com,teammate@example.com
# In test mode, bulk emails only deliver the first N
EMAIL_TEST_MAX_PER_BATCH=5

# Other switches
EMAIL_DISABLED=false
EMAIL_JOBS_ENABLED=true
EMAIL_RATE_PER_MINUTE=120
COHORT_TIMEZONE=Africa/Lagos

# Cohort login: "false" turns off the old email-based password login
# (students then log in with the emailed link only - recommended)
COHORT_PASSWORD_LOGIN=true

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
PAYSTACK_SECRET_KEY=
CRYPTO_PAYMENT_WALLET=

# Twitter / X
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=
USER_TWITTER_CALLBACK_URL=
TWITTER_PROJECT_CALLBACK_URL=

# Other services
GOOGLE_API_KEY=
TELEGRAM_BOT_TOKEN=
ADZUNA_ID=
ADZUNA_KEY=
RAPID_API_KEY=
RAPID_API_HOST=
